{
  "name": "smart-event-workspace",
  "private": true,
  "scripts": {
    "dev:api": "zsh -lc 'set -a; [ -f .env ] && source .env; set +a; cd apps/api && npm run start'",
    "dev:admin": "zsh -lc 'set -a; [ -f .env ] && source .env; set +a; cd apps/admin && PORT=${ADMIN_PORT:-3001} npm run dev -- --port ${ADMIN_PORT:-3001}'",
    "db:reset:demo": "node tools/reset_demo_db.mjs",
    "seed:demo": "zsh -lc 'set -a; [ -f .env ] && source .env; set +a; node tools/seed_demo.mjs'",
    "check:ai": "zsh -lc 'set -a; [ -f .env ] && source .env; set +a; node tools/check_local_ai.mjs'",
    "win:doctor": "powershell -ExecutionPolicy Bypass -File tools/windows/doctor.ps1",
    "win:install": "powershell -ExecutionPolicy Bypass -File tools/windows/install-deps.ps1",
    "win:db": "powershell -ExecutionPolicy Bypass -File tools/windows/start-db.ps1",
    "win:api": "powershell -ExecutionPolicy Bypass -File tools/windows/run-api.ps1",
    "win:admin": "powershell -ExecutionPolicy Bypass -File tools/windows/run-admin.ps1",
    "win:seed": "powershell -ExecutionPolicy Bypass -File tools/windows/seed-demo.ps1",
    "win:ai": "powershell -ExecutionPolicy Bypass -File tools/windows/check-ai.ps1",
    "win:mobile": "powershell -ExecutionPolicy Bypass -File tools/windows/run-mobile-web.ps1"
  }
}
