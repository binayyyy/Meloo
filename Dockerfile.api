FROM node:22-alpine AS api-deps
WORKDIR /app/apps/api
COPY apps/api/package*.json ./
RUN npm ci

FROM node:22-alpine AS api-build
WORKDIR /app
COPY --from=api-deps /app/apps/api/node_modules ./apps/api/node_modules
COPY apps/api ./apps/api
COPY tools ./tools
RUN cd apps/api && npm run build

FROM node:22-alpine AS api-runtime-deps
WORKDIR /app/apps/api
COPY apps/api/package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

FROM node:22-alpine AS api-runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=api-runtime-deps /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=api-build /app/apps/api/dist ./apps/api/dist
COPY --from=api-build /app/apps/api/package.json ./apps/api/package.json
EXPOSE 3000
CMD ["node", "apps/api/dist/main.js"]

FROM node:22-alpine AS seed-runtime
WORKDIR /app
COPY tools ./tools
CMD ["node", "tools/seed_demo.mjs"]
